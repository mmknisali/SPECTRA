#!/usr/bin/env bash

# SPECTRA Development Environment
# This file is used by direnv to auto-configure the environment

# Fix libstdc++ issue for Nix environments
if [ -d /nix/store ]; then
  GCC_LIB=$(find /nix/store -maxdepth 1 -name "*gcc*lib*" -type d 2>/dev/null | head -1)
  if [ -n "$GCC_LIB" ]; then
    export LD_LIBRARY_PATH="$GCC_LIB/lib:$LD_LIBRARY_PATH"
  fi
fi

# Activate virtual environment if it exists
if [ -d "venv" ]; then
  source venv/bin/activate
fi

# Set Python path to project root
export PYTHONPATH="$PWD"
export SPECTRA_ENV=development

# Show banner (only in interactive shells)
if [[ $- == *i* ]]; then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  SPECTRA - Clinical Decision Support System"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "  Commands:"
  echo "    python -m backend.export_data    # Process data files"
  echo "    python -m backend.api            # Start API server"
  echo "    python -m backend.cancer_classifier  # Train ML model"
  echo ""
  echo "  Environment: $SPECTRA_ENV"
  echo "  Python: $(python3 --version 2>/dev/null || echo 'not found')"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
fi
