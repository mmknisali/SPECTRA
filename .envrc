#!/usr/bin/env bash

# Fix libstdc++ issue - path discovered from nix gcc package
export LD_LIBRARY_PATH=/nix/store/ab3753m6i7isgvzphlar0a8xb84gl96i-gcc-15.2.0-lib/lib:$LD_LIBRARY_PATH

source venv/bin/activate
export PYTHONPATH="$PWD"
export SPECTRA_ENV=dev

# Show banner
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " SPECTRA - Oncology Assistant"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

echo "✅ Environment ready!"
echo ""
echo "Commands:"
echo " python3 -m backend.export_data → Process data"
echo " python3 -m backend.cancer_classifier → Train XGBoost"
echo " python3 -m backend.api → Start API"
echo " streamlit run frontend/app.py → Start UI"
echo " ./scripts/setup.sh  → Install requirements "
echo ""
