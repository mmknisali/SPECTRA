# SPECTRA Production Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=SPECTRA
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================
# SECURITY - CHANGE THESE!
# ============================================
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-32chars-min

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bcrypt rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ============================================
# DATABASE - CHANGE PASSWORDS!
# ============================================
DB_HOST=db
DB_PORT=3306
DB_NAME=spectra_db
DB_USER=spectra_user
DB_PASSWORD=change-this-to-a-secure-password
DB_ROOT_PASSWORD=change-this-to-another-secure-password

# Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================
# RATE LIMITING & SECURITY
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# CORS
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# AI/LLM SETTINGS
# ============================================
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2:7b-instruct-q5_K_M
OLLAMA_TIMEOUT=120

# ============================================
# SSL/TLS (Optional - for HTTPS)
# ============================================
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
FORCE_HTTPS=true

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# BACKUP SETTINGS
# ============================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7

# ============================================
# VAST.AI DEPLOYMENT (GitHub Actions)
# ============================================
# These are set as GitHub Secrets, not in this file:
# - VAST_HOST
# - VAST_PORT
# - VAST_USER
# - VAST_SSH_KEY
# - GITHUB_TOKEN
